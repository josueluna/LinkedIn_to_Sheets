      GitHub
    </a>
  </div>
</footer>

<script>
  var canObserve = 'IntersectionObserver' in window;
  var revealIO = canObserve
    ? new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealIO.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' })
    : null;

  function reveal(scope) {
    var root = scope || document;
    var els = root.querySelectorAll('.reveal');
    if (!els.length) return;
    if (!canObserve) {
      els.forEach(function (el) { el.classList.add('is-visible'); });
      return;
    }
    els.forEach(function (el) { revealIO.observe(el); });
  }

  reveal(document);

  // Load changelog from GitHub and split into per-version glass panels
  (function () {
    var url = 'https://raw.githubusercontent.com/josueluna/LinkedIn_to_Sheets/refs/heads/main/CHANGELOG.md';
    var target = document.getElementById('changelog-content');

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, function (c) {
        return ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[c];
      });
    }

    function renderVersions(md) {
      // Match each "## vX.Y.Z" heading and capture its body up to the next version heading (or EOF).
      // Horizontal-rule separators (---) between versions are stripped.
      var versionRe = /^[ \\t]*##[ \\t]+(v\\d[\\w.\\-+]*)[ \\t]*\\r?\\n([\\s\\S]*?)(?=^[ \\t]*##[ \\t]+v\\d|\\Z)/gmi;
      var matches = [];
      var m;
      // JS doesn't support \\Z; emulate by appending sentinel
      var src = md + '\\n## v0.0.0-__end__\\n';
      while ((m = versionRe.exec(src)) !== null) {
        if (m[1] === 'v0.0.0-__end__') break;
        matches.push({ version: m[1], body: m[2] });
      }

      if (!matches.length) {
        // Fallback: render the whole markdown in one card so we never lose content.
        target.innerHTML =
        '<div class="content-card reveal">' +
        '<div class="markdown-body">' + marked.parse(md) + '</div>' +
        '</div>';
        reveal(target);
        return;
      }

      var html = '<div class="versions">';
      matches.forEach(function (entry, i) {
        // Strip leading/trailing horizontal rules and whitespace from the body.
        var body = entry.body
        .replace(/^\\s*(?:-{3,}|\\*{3,}|_{3,})\\s*$/gm, '')
        .trim();
        var rendered = marked.parse(body);
        var latest = i === 0
        ? '<span class="version-latest">Latest</span>'
        : '';
        html +=
        '<article class="version-card reveal" style="transition-delay:' + Math.min(i * 60, 240) + 'ms;">' +
        '<header class="version-head">' +
        '<span class="version-badge">' + escapeHtml(entry.version) + '</span>' +
        latest +
        '</header>' +
        '<div class="markdown-body">' + rendered + '</div>' +
        '</article>';
      });
      html += '</div>';
      requestAnimationFrame(function () {
        target.innerHTML = html;
        reveal(target);
      });
    }

    fetch(url, { cache: 'force-cache' })
    .then(function (r) { if (!r.ok) throw new Error('Not found'); return r.text(); })
    .then(renderVersions)
    .catch(function () {
      target.innerHTML =
      '<div class="content-card reveal">' +
      '<p style="text-align:center;color:var(--muted-fg);">Couldn\\'t load the changelog right now. Try again later or visit the <a href="https://raw.githubusercontent.com/josueluna/LinkedIn_to_Sheets/develop/CHANGELOG.md?plain=1" target="_blank" rel="noopener" style="color:var(--linkedin);">repository</a>.</p>' +
      '</div>';
      reveal(target);
    });
  })();
</script>

<script>
(function(){
    var docLinks=['index.html','privacy.html','changelog.html'];
  docLinks.forEach(function(h){ if(location.pathname.indexOf(h)===-1){ var l=document.createElement('link'); l.rel='prefetch'; l.href=h; document.head.appendChild(l);} });
  document.addEventListener('click', function(e){
    var a=e.target.closest('a[href]');
    if(!a) return;
    var href=a.getAttribute('href');
    if(!href || href.startsWith('#') || a.target==='_blank' || a.hasAttribute('download')) return;
    var u=new URL(a.href, location.href);
    if(u.origin!==location.origin) return;
    if(!/\\/(index|privacy|changelog)\\.html$/.test(u.pathname) && !/\\/LinkedIn_to_Sheets\\/$/.test(u.pathname)) return;
    document.body.classList.add('page-exit');
  },{passive:true});
})();
</script>"
`;

